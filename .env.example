# Copy to .env and fill in. .env is gitignored; never commit it.
# Values left blank below have no safe default and must be set by you.

# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
# Optional while DJANGO_DEBUG=1; required when DJANGO_DEBUG=0.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# These defaults match docker-compose.yml and are fine for a localhost-only
# dev database. Change both places together if you want different values.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3315
MYSQL_DATABASE=supermarkt
MYSQL_USER=supermarkt
MYSQL_PASSWORD=supermarkt
MYSQL_ROOT_PASSWORD=rootpass

AH_USER_AGENT=
AH_COOKIE=
AH_REQUEST_DELAY=0.3
AH_TIMEOUT=20
AH_BROWSER_HEADLESS=1
AH_BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome
AH_BROWSER_USER_DATA_DIR=
AH_BROWSER_PROFILE_DIR=Default

# Required by `manage.py bootstrap_superuser`, which grants superuser access.
# No default on purpose: the command fails loudly if this is blank.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

OPENSEARCH_ENABLED=0
OPENSEARCH_URL=http://127.0.0.1:9201
OPENSEARCH_INDEX_NAME=supermarkt_products
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TIMEOUT=10
OPENSEARCH_VERIFY_SSL=0
OPENSEARCH_AUTO_INDEX_ON_SAVE=0

# vLLM endpoint used by the recipe planner, image analysis, and product-quality
# enrichment. Required for those features; the rest of the app works without it.
RUNPOD_VLLM_HOST=
VLLM_MODEL=
VLLM_API_KEY=
VLLM_TIMEOUT=120

# Optional: separate vision endpoint. Falls back to the vLLM values above.
VISION_VLLM_HOST=
VISION_MODEL=
VISION_API_KEY=

FORKCAST_AUTO_OPENSEARCH_REINDEX=0
FORKCAST_AUTO_OPENSEARCH_BATCH_SIZE=1000
